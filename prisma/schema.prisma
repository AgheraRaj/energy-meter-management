// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MeterStatus {
  active
  offline
  maintenance
}

model Meter {
  id            Int         @id @default(autoincrement())
  name          String
  location      String?
  status        MeterStatus @default(active)
  minPowerKw    Float?      @map("min_power_kw")
  maxPowerKw    Float?      @map("max_power_kw")
  createdAt     DateTime    @default(now()) @map("created_at")
  readings      Reading[]
  alerts        Alert[]

  @@map("meters")
}

enum AlertSeverity {
  warning
  critical
}

model Alert {
  id            Int                @id @default(autoincrement())
  meterId       Int                @map("meter_id")
  meter         Meter              @relation(fields: [meterId], references: [id], onDelete: Cascade)
  message       String
  severity      AlertSeverity      @default(warning)
  value         Float
  acknowledged  Boolean            @default(false)
  createdAt     DateTime           @default(now()) @map("created_at")
  notifications NotificationLog[]

  @@index([meterId, createdAt(sort: Desc)])
  @@map("alerts")
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  alertId   Int      @map("alert_id")
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  meterId   Int      @map("meter_id")
  channel   String   @default("whatsapp")
  status    String   // "sent" | "failed" | "skipped_cooldown"
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([meterId, channel, createdAt(sort: Desc)])
  @@map("notification_logs")
}

model Reading {
  id         Int      @id @default(autoincrement())
  meterId    Int      @map("meter_id")
  meter      Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  voltage    Float
  current    Float
  powerKw    Float    @map("power_kw")
  energyKwh  Float    @map("energy_kwh")
  recordedAt DateTime @map("recorded_at")

  @@index([meterId, recordedAt(sort: Desc)])
  @@map("readings")
}

model Settings {
  id         Int   @id @default(1) // singleton row, always id=1
  ratePerKwh Float @default(8.5) @map("rate_per_kwh")

  @@map("settings")
}