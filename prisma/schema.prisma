// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MeterStatus {
  active
  offline
  maintenance
}

enum MeterType {
  transformer
  equipment
}

model Meter {
  id               Int         @id @default(autoincrement())
  code             String?
  name             String
  location         String?
  status           MeterStatus @default(active)
  minPowerKw       Float?      @map("min_power_kw")
  maxPowerKw       Float?      @map("max_power_kw")
  createdAt        DateTime    @default(now()) @map("created_at")
  type             MeterType   @default(equipment)
  feederCode       String?     @map("feeder_code")
  bus              String?
  ratedKw          Float?      @map("rated_kw") // nameplate rating: kW for equipment, kVA for transformers
  parentMeterId    Int?        @map("parent_meter_id")
  parentMeter      Meter?      @relation("TransformerToEquipment", fields: [parentMeterId], references: [id], onDelete: SetNull)
  childMeters      Meter[]     @relation("TransformerToEquipment")
  readings         Reading[]
  alerts           Alert[]
  alarmSetpointKva Float?      @map("alarm_setpoint_kva") // transformer-only; null on both this and alertSetpointKva means "alerting off"
  alertSetpointKva Float?      @map("alert_setpoint_kva")
  overageEvents OverageEvent[]

  @@map("meters")
}

enum AlertSeverity {
  warning
  critical
  normal
}

model Alert {
  id            Int                @id @default(autoincrement())
  meterId       Int                @map("meter_id")
  meter         Meter              @relation(fields: [meterId], references: [id], onDelete: Cascade)
  message       String
  severity      AlertSeverity      @default(warning)
  value         Float
  acknowledged  Boolean            @default(false)
  createdAt     DateTime           @default(now()) @map("created_at")
  notifications NotificationLog[]

  @@index([meterId, createdAt(sort: Desc)])
  @@map("alerts")
}

model NotificationLog {
  id                Int      @id @default(autoincrement())
  alertId           Int      @map("alert_id")
  alert             Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  meterId           Int      @map("meter_id")
  channel           String   @default("whatsapp")
  status            String   // "sent" | "failed" | "skipped_cooldown" | "skipped_disabled"
  error             String?
  providerMessageId String?  @map("provider_message_id") // Zavu's message.id, for cross-referencing their dashboard/API
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([meterId, channel, createdAt(sort: Desc)])
  @@map("notification_logs")
}

model Reading {
  id               Int      @id @default(autoincrement())
  meterId          Int      @map("meter_id")
  meter            Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  voltage          Float
  current          Float
  powerKw          Float    @map("power_kw")
  energyKwh        Float    @map("energy_kwh")
  thd              Float?   @map("thd") // Total Harmonic Distortion %
  powerFactor      Float?   @map("power_factor")
  frequencyHz      Float?   @map("frequency_hz")
  apparentPowerKva Float?   @map("apparent_power_kva")
  voltageR         Float?   @map("voltage_r")
  voltageY         Float?   @map("voltage_y")
  voltageB         Float?   @map("voltage_b")
  currentR         Float?   @map("current_r")
  currentY         Float?   @map("current_y")
  currentB         Float?   @map("current_b")
  powerKwR         Float?   @map("power_kw_r")
  powerKwY         Float?   @map("power_kw_y")
  powerKwB         Float?   @map("power_kw_b")
  recordedAt       DateTime @map("recorded_at")

  @@index([meterId, recordedAt(sort: Desc)])
  @@map("readings")
}

model OverageEvent {
  id              Int       @id @default(autoincrement())
  meterId         Int       @map("meter_id")
  meter           Meter     @relation(fields: [meterId], references: [id], onDelete: Cascade)
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at") // null while still ongoing
  lastSampleAt    DateTime  @map("last_sample_at")
  thresholdValue  Float     @map("threshold_value") // the setpoint active when this event started
  peakValue       Float     @map("peak_value") // highest kVA/kW observed during the event
  excessUnitHours Float     @default(0) @map("excess_unit_hours") // accumulated kVAh or kWh above threshold
  unit            String    // "kVA" (transformer) | "kW" (equipment)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([meterId, startedAt(sort: Desc)])
  @@map("overage_events")
}

model Settings {
  id                            Int       @id @default(1)
  ratePerKwh                    Float     @default(8.5) @map("rate_per_kwh")
  alarmSetpointKw               Float     @default(1400.0) @map("alarm_setpoint_kw")
  alertSetpointKw               Float     @default(1450.0) @map("alert_setpoint_kw")
  referenceCapacityKw           Float     @default(1500.0) @map("reference_capacity_kw")
  transformerPenaltyRatePerKvah Float     @default(5.0) @map("transformer_penalty_rate_per_kvah")
  equipmentPenaltyRatePerKwh    Float     @default(2.0) @map("equipment_penalty_rate_per_kwh")
  billingCycleAnchorDate        DateTime? @map("billing_cycle_anchor_date")

  @@map("settings")
}